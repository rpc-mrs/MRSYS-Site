# SMTP-сервер для отправки писем с формы обратной связи (/api/send-email)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-mailbox@yandex.ru
SMTP_PASSWORD=app-password-here

# Необязательно: куда доставлять письма с формы.
# Если не задано — письма уходят на SMTP_USER.
CONTACT_TO=dir@mrsys.ru

# Полный адрес сайта — используется в sitemap.xml, robots.txt,
# canonical-ссылках и Open Graph тегах. Обязательно укажите реальный
# домен перед публикацией.
NEXT_PUBLIC_SITE_URL=https://mrsys.ru
